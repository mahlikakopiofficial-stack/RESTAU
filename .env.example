# Copy to .env and edit. Never commit .env.
PORT=3000
NODE_ENV=production
# 16+ random characters. Generate: openssl rand -hex 32
SECRET=put-a-long-random-string-here
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_HOST=admin-pinoy-ambula.duckdns.org
CURRENCY=KWD
DELIVERY_FEE=1
RESTO_NAME=PinoyAmbula
PUBLIC_BASE_URL=https://pinoyambulakw.duckdns.org
# Gmail API OAuth (required for customer emails, admin alerts, and newsletters).
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_OAUTH_STATE=generate-a-long-random-state-value
# Complete /api/gmail/oauth/start once to save this token to the server's .env.
GMAIL_REFRESH_TOKEN=
# Optional: defaults to GMAIL_USER.
GMAIL_ADMIN_NOTIFY_TO=admin@example.com
GMAIL_FROM_NAME=PinoyAmbula
# Queued newsletter sends are spaced apart to reduce the risk of Gmail limits.
NEWSLETTER_INTERVAL_MS=60000
# WhatsApp Cloud API (optional; customers must explicitly opt in).
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Use an approved Meta template containing one BODY text placeholder for
# notifications outside the 24-hour customer-service window.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# 0 = /check.html disabled (keep 0 in production)
ENABLE_CHECK=0
